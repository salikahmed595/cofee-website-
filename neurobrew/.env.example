# Copy to .env and fill in. Never commit .env.
PORT=8787
# Public origin of the site (used for Stripe return links), e.g. https://neurobrew.com
PUBLIC_URL=http://localhost:8787
# Long random string (24+ chars). Needed to open /#admin. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# Stripe secret key. Use sk_test_... until you are ready to take real money. Leave empty to offer pay-on-delivery only.
STRIPE_SECRET_KEY=
# Where orders are stored (SQLite file)
DATABASE_FILE=./data/neurobrew.db
# Set to 1 when running behind a reverse proxy / load balancer so rate limits see the real client IP
TRUST_PROXY=0
